# Скопируйте в .env.local и заполните. .env.local не коммитится.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — только сервер, никогда не добавляйте префикс NEXT_PUBLIC_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Дневной лимит запросов к Gemini на одного пользователя
AI_DAILY_LIMIT_PER_USER=100
