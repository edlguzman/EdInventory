# Скопируйте в .env.local и заполните. .env.local не коммитится.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — только сервер, никогда не добавляйте префикс NEXT_PUBLIC_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Дневной лимит запросов к Gemini на одного пользователя
AI_DAILY_LIMIT_PER_USER=100     # fallback daily AI limit when a plan has no ai_daily_limit

# Vercel Cron: /api/cron/keepalive (раз в сутки, чтобы Supabase Free не уходил в паузу).
# Случайная строка не короче 16 символов, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel сам передаёт её в заголовке Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Книги по ISBN: Open Library (без ключа), недостающее — из Google Books. Без ключа Google Books
# часто отвечает 429 (общий анонимный лимит). Необязательно, только сервер:
# Google Cloud → APIs & Services → Books API → Credentials → API key (ограничить: Books API).
GOOGLE_BOOKS_API_KEY=

# Только сервер и только для удаления пользователя админом (его фото в Storage и сам аккаунт).
# Supabase → Project Settings → API Keys → service_role (или secret key). Никогда не NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Письма админу о новых регистрациях и удалённых аккаунтах (Resend, resend.com → API Keys).
# Без своего домена Resend шлёт только на email владельца аккаунта Resend: его и укажите.
# Если не заданы, письма просто не отправляются.
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=

# Отправитель писем: "Inventory <noreply@ваш-домен>". Домен должен быть подтверждён в Resend
# (Domains → Add domain, DNS-записи у регистратора). Пока не задан, письма пользователям
# (регистрация получена / одобрен / отключён) не отправляются, а письма админу идут
# с тестового адреса Resend.
MAIL_FROM=

# Local testing only (never in Vercel): separate test account for checking Preview builds
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
